---
# Copy this file to secrets.yml (gitignored) and set real credentials.
# Never commit secrets.yml.

# Auth
# These credentials will be used for the local OpenShift admin user
htpasswd_username: "admin"
htpasswd_password: "changeme"

# Cert-manager
acme_email: "you@example.com"
cloudflare_api_token: "cfat_something"

# Optional: console password for the Fedora smoke-test VM. Do not reuse the admin password.
# smoke_vm_password: "replace-with-a-unique-password"
