---
# Copy this file to secrets.yml (gitignored) and set real credentials.
# Never commit secrets.yml.

# Auth
# These credentials will be used for the local OpenShift admin user
htpasswd_username: "admin"
htpasswd_password: "changeme"

# Cert-manager
# Configures Let’s Encrypt with Cloudflare DNS-01 validation
# The Cloudflare API token needs to be created under Account API tokens.
# It needs Zone -> DNS -> Edit, and Zone -> Zone -> Read permissions, scoped at the specific domain
acme_email: "you@example.com"
cloudflare_api_token: "cfat_something"
